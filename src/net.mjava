// ---------- 失败原因 ----------
// 只记「最近一次」的失败类型，给阅读器上屏和「查看详情」用。
// 上屏的内容会被人看到，所以**只记类型**（HTTP 状态码、异常类名），不记请求地址/完整异常消息：
// 那些带接口路径和参数，不该出现在界面上；完整信息只写 logcat。
// 工作线程写 i.sss 可能抛 Hashtable.put on null，所以这里一律吞掉：诊断尽力而为，不影响请求本身。

public void net_errClear() {
	try {
		i.sss("net.err", "");
	} catch (Throwable t) {
	}
}

public void net_err(String s) {
	try {
		i.sss("net.err", s);
	} catch (Throwable t) {
	}
	i.syso("NET ERR " + s);
}

public String net_lastError() {
	try {
		Object o = i.sss("net.err");
		return o == null ? "" : String.valueOf(o);
	} catch (Throwable t) {
		return "";
	}
}

// ---------- HTTP ----------

public String net_get(String url) {
	HttpURLConnection c = null;
	try {
		URL u = new URL(url);
		c = (HttpURLConnection) u.openConnection();
		c.setConnectTimeout(15000);
		c.setReadTimeout(30000);
		c.setRequestProperty("User-Agent", "Mozilla/5.0");
		c.setInstanceFollowRedirects(true);
		int code = c.getResponseCode();
		if (code < 200 || code >= 300) {
			net_err("HTTP 状态码 " + code);
			i.syso("NET HTTP " + code + " " + url);
			c.disconnect();
			return null;
		}
		InputStream in = c.getInputStream();
		BufferedReader r = new BufferedReader(new InputStreamReader(in, "UTF-8"));
		StringBuilder sb = new StringBuilder();
		String line = r.readLine();
		while (line != null) {
			sb.append(line);
			sb.append("\n");
			line = r.readLine();
		}
		r.close();
		c.disconnect();
		return sb.toString();
	} catch (Throwable t) {
		// 界面上只给异常类名；完整堆栈与地址只进 logcat
		net_err("网络异常 " + t.getClass().getName());
		i.syso("NET ! " + t + " " + url);
		try {
			if (c != null) {
				c.disconnect();
			}
		} catch (Throwable x) {
		}
		return null;
	}
}

public String net_enc(String s) {
	try {
		return URLEncoder.encode(s, "UTF-8");
	} catch (Throwable t) {
		return s;
	}
}

