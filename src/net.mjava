// psize=0：只取目录与总页数，contents 为空（比 psize=1 少一条正文）
public JSONObject net_catalog(String surl) {
	String u = net_readUrl(surl, 0, 1);
	if (u == null) {
		return null;
	}
	return net_msg(net_json(net_get(u)));
}

// 取 target 页所在的整段；段内页号偏移 = page - start
public JSONObject net_chunkAt(String surl, int target) {
	int size = net_chunk();
	int start = ((target - 1) / size) * size + 1;
	String key = surl + "|" + net_w() + net_h() + net_fsize() + "|" + start;
	String hit = net_cacheGet(key);
	if (hit != null) {
		return net_json(hit);
	}
	String u = net_readUrl(surl, size, start);
	if (u == null) {
		return null;
	}
	String body = net_get(u);
	if (body == null) {
		return null;
	}
	JSONObject msg = net_msg(net_json(body));
	if (msg != null) {
		net_cachePut(key, body);
	}
	return msg;
}

// 只查缓存，不发请求
public JSONObject net_chunkLookup(String surl, int target) {
	int size = net_chunk();
	int start = ((target - 1) / size) * size + 1;
	String key = surl + "|" + net_w() + net_h() + net_fsize() + "|" + start;
	String hit = net_cacheGet(key);
	if (hit == null) {
		return null;
	}
	// 缓存里存的是整段响应体，返回前必须取出 msg，与 net_chunkAt 保持一致
	return net_msg(net_json(hit));
}

// 段起点（页号）与段内下标
public int net_chunkStart(int target) {
	int size = net_chunk();
	int p = target;
	if (p < 1) {
		p = 1;
	}
	return ((p - 1) / size) * size + 1;
}

public String net_pageHtml(JSONObject chunk, int target) {
	try {
		JSONArray arr = chunk.optJSONArray("contents");
		if (arr == null) {
			return null;
		}
		int idx = target - net_chunkStart(target);
		if (idx < 0 || idx >= arr.length()) {
			return null;
		}
		return arr.optString(idx, null);
	} catch (Throwable t) {
		return null;
	}
}

public int net_pageAll(JSONObject chunk) {
	try {
		if (chunk == null) {
			return 0;
		}
		return chunk.optInt("pageAll", 0);
	} catch (Throwable t) {
		return 0;
	}
}

public int net_clampPage(int p, int pageAll) {
	if (pageAll <= 0) {
		return 1;
	}
	if (p < 1) {
		return 1;
	}
	if (p > pageAll) {
		return pageAll;
	}
	return p;
}

// ---------- 分段缓存：交给 android.util.LruCache ----------
// 不重写 sizeOf（那是「继承类」，BeanShell 只能匿名实现接口），按条数淘汰：
// 8 段 ≈ 1~2 MB，够覆盖来回翻页的窗口。

public LruCache net_cache() {
	Object o = i.sss("jy.cache.lru");
	if (o == null) {
		o = new LruCache(8);
		i.sss("jy.cache.lru", o);
	}
	return (LruCache) o;
}

// 在 UI 线程先把缓存对象建出来：工作线程首次调用时 i.sss 写可能抛，
// 那会让缓存静默失效（请求照发，只是每次都不命中）
public void net_cacheInit() {
	net_cache();
}

public String net_cacheGet(String key) {
	try {
		Object v = net_cache().get(key);
		if (v == null) {
			return null;
		}
		return String.valueOf(v);
	} catch (Throwable t) {
		return null;
	}
}

public void net_cachePut(String key, String val) {
	try {
		net_cache().put(key, val);
	} catch (Throwable t) {
		i.syso("NET cache ! " + t);
	}
}

public void net_cacheClear() {
	try {
		net_cache().evictAll();
	} catch (Throwable t) {
	}
}
