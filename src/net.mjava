public JSONObject net_json(String s) {
	if (s == null) {
		return null;
	}
	try {
		return new JSONObject(s);
	} catch (Throwable t) {
		net_err("响应解析失败 " + t.getClass().getName());
		return null;
	}
}

// 统一取 msg：result==1 才有效，否则 null（result==0 是业务空，不是网络失败）
public JSONObject net_msg(JSONObject d) {
	try {
		if (d == null) {
			return null;
		}
		if (d.optInt("result", 0) != 1) {
			net_err("服务端拒绝 result=" + d.optInt("result", 0) + "，errorMsg=" + d.optString("errorMsg", "（空）"));
			return null;
		}
		return d.optJSONObject("msg");
	} catch (Throwable t) {
		return null;
	}
}

// ---------- token ----------

public String net_regex(String s, String pat) {
	try {
		Pattern p = Pattern.compile(pat);
		Matcher m = p.matcher(s);
		if (m.find()) {
			return m.group(1);
		}
	} catch (Throwable t) {
	}
	return null;
}

// 返回 {sid, from, detailUrl}；按 surl 缓存，同一本书只换一次
public JSONObject net_token(String surl) {
	try {
		Object cached = i.sss("jy.tk." + surl);
		if (cached != null) {
			return new JSONObject(String.valueOf(cached));
		}
	} catch (Throwable t) {
	}

	String full = surl;
	if (!full.startsWith("http")) {
		full = "https://" + full;
	}
	String html = net_get(net_base() + "/o/a.h?a=GEDE:" + net_enc(full));
	if (html == null) {
		// net_get 已经写过原因（HTTP 码 / 异常），保持那条，不再覆盖
		return null;
	}
	String sid = net_regex(html, "sid:\\s*'([^']*)'");
	String from = net_regex(html, "from:\\s*'([^']*)'");
	String du = net_regex(html, "detailUrl:\\s*'([^']+)'");
	if (sid == null || from == null || du == null) {
		// 实测：书不存在时 /o/a.h 会被重定向到 error400.jsp，页面标题是 400、
		// 正文「未查询到相关图书的 idKey 参数错误」，三个字段一个都没有
		String tt = net_regex(html, "<title>([^<]*)</title>");
		i.syso("NET token 缺字段 title=" + tt);
		net_err("书不存在或已下线（接口返回错误页" + (tt == null ? "" : " " + tt) + "）");
		return null;
	}
	JSONObject o = new JSONObject();
	try {
		o.put("sid", sid);
		o.put("from", from);
		o.put("detailUrl", du);
	} catch (Throwable t) {
		return null;
	}
	// 缓存写失败不能让已经拿到的令牌作废：i.sss 在工作线程写可能抛
	// Hashtable.put on null，以前的写法会把 return 一起吞掉，表现成偶发「加载失败」
	try {
		i.sss("jy.tk." + surl, o.toString());
	} catch (Throwable t) {
		net_err("令牌缓存写入失败（不影响本次阅读）" + t.getClass().getName());
	}
	return o;
}

public void net_tokenDrop(String surl) {
	try {
		i.sss("jy.tk." + surl, null);
	} catch (Throwable t) {
	}
}

// ---------- 目录 / 正文 ----------

public String net_readUrl(String surl, int psize, int page) {
	JSONObject tk = net_token(surl);
	if (tk == null) {
		return null;
	}
	return net_base() + "/other/epub_epubRead_readNew.jspx?psize=" + psize + "&page=" + page
			+ "&ucatalog=true&ctype=3&w=" + net_w() + "&h=" + net_h() + "&fsize=" + net_fsize()
