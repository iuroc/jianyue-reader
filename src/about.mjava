public void back() {
	activity.finish();
}

public void key(Object kc) {
	int code = 0;
	try {
		if (kc instanceof Number) {
			code = ((Number) kc).intValue();
		}
	} catch (Throwable t) {
	}
	if (code == 4) {
		back();
	}
}

// ---------- 骨架 ----------

public void build() {
	View bg = ui_layer("bg");
	if (bg != null) {
		bg.setBackgroundColor(ui_color(th_bg()));
	}
	View safe = ui_layer("safe");
	if (safe == null) {
		return;
	}

	LinearLayout page = ui_col();
	ui_add((ViewGroup) safe, page, -1, -1);

	page.addView(wg_header("关于", "", new Runnable() {
		public void run() {
			back();
		}
	}, null));
	page.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));

	ScrollView sv = new ScrollView(activity);
	sv.setVerticalScrollBarEnabled(false);
	ui_addWeight(page, sv, -1, 0, 1f);

	LinearLayout body = ui_col();
	body.setPadding(ui_dp(20), ui_dp(24), ui_dp(20), ui_dp(40));
	sv.addView(body, new FrameLayout.LayoutParams(-1, -2));

	// 品牌
	TextView brand = ui_text("简阅", 28, th_ink1());
	brand.setTypeface(null, Typeface.BOLD);
	brand.setLetterSpacing(0.18f);
	body.addView(brand);

	// 版本号运行时从包读取，改 AndroidManifest 即可，页面不再写死
	String ver = ui_versionText();
	TextView tagline = ui_text("歌德借阅机内容阅读器 · " + ("开发版".equals(ver) ? "开发版" : "版本 " + ver), 13, th_ink2());
	LinearLayout.LayoutParams tlp = new LinearLayout.LayoutParams(-1, -2);
	tlp.topMargin = ui_dp(8);
	tagline.setLayoutParams(tlp);
	body.addView(tagline);

	body.addView(ab_pill("实验室试用版 · 学习用途"));

	// 作者 / 项目：标签占左列、值在右，三行同一套对齐；地址本身可点
	body.addView(ab_kv("作者", ab_author(), ab_author(), 28));
	body.addView(ab_kv("QQ", "2329632875", null, 0));
	body.addView(ab_kv("项目", ab_repo(), ab_repo(), 8));

	body.addView(ab_note("以学习研究为目的开源，欢迎交流指正。"));

	// 合规声明
	TextView head = ui_text("使用说明", 17, th_ink1());
	LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(-1, -2);
	hlp.topMargin = ui_dp(28);
	head.setLayoutParams(hlp);
	body.addView(head);

	body.addView(ab_para("本应用是个人学习与研究性质的实验室软件，用于验证 Android 客户端开发的学习方法，不以商业发布、分发或运营为目的，与歌德借阅机运营方及书刊出版方均无关联。"));
	body.addView(ab_para("应用使用的书刊目录与正文接口并非官方公开 API，而是通过数据抓包方式获得的接口地址，仅用于个人学习研究，不用于任何商业用途，也不保证接口的可用性与长期有效性。"));
