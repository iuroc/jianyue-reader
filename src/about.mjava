// ---------- 组件 ----------

// 小圆角标签：描边朱砂、透明底，用来把「这软件是什么性质」摆在最上面
public TextView ab_pill(String s) {
	TextView t = ui_text(s, 12, th_accent());
	t.setLetterSpacing(0.06f);
	t.setGravity(Gravity.CENTER);
	t.setPadding(ui_dp(12), ui_dp(5), ui_dp(12), ui_dp(5));

	GradientDrawable d = new GradientDrawable();
	d.setShape(GradientDrawable.RECTANGLE);
	d.setCornerRadius(ui_dp(14));
	d.setColor(ui_color(th_bg()));
	d.setStroke(ui_dp(1), ui_color(th_accent()));
	t.setBackground(d);

	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);
	lp.topMargin = ui_dp(14);
	t.setLayoutParams(lp);
	return t;
}

// 键值行：左列固定 56dp 标签、右侧值；url 非空时值画成朱砂外链，点开系统浏览器
// （没有浏览器时静默失败，不弹窗打断）
public View ab_kv(String k, String v, String url, int topDp) {
	LinearLayout row = ui_row();
	row.setGravity(Gravity.CENTER_VERTICAL);
	row.setPadding(ui_dp(0), ui_dp(8), ui_dp(0), ui_dp(8));
	LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(-1, -2);
	rlp.topMargin = ui_dp(topDp);
	row.setLayoutParams(rlp);

	TextView kt = ui_text(k, 13, th_ink2());
	row.addView(kt, new LinearLayout.LayoutParams(ui_dp(56), -2));

	boolean link = url != null && url.length() > 0;
	TextView vt = ui_text(v, 15, link ? th_accent() : th_ink1());
	vt.setLineSpacing(0f, 1.3f);
	row.addView(vt, new LinearLayout.LayoutParams(0, -2, 1f));

	if (link) {
		String u = url;
		row.setOnClickListener(new View.OnClickListener() {
			public void onClick(View vv) {
				try {
					Intent it = new Intent("android.intent.action.VIEW", Uri.parse(u));
					activity.startActivity(it);
				} catch (Throwable t) {
				}
			}
		});
		wg_ripple(row, 6, false);
	}
	return row;
}

public TextView ab_para(String s) {
	TextView t = ui_text(s, 15, th_ink1());
	t.setLineSpacing(0f, 1.55f);
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-1, -2);
	lp.topMargin = ui_dp(14);
	t.setLayoutParams(lp);
	return t;
}

public TextView ab_note(String s) {
	TextView t = ui_text(s, 13, th_ink2());
	t.setLineSpacing(0f, 1.4f);
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-1, -2);
	lp.topMargin = ui_dp(14);
	t.setLayoutParams(lp);
	return t;
}
