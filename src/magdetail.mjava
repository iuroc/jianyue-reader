// 期刊详情：与图书详情同构（封面 / 刊名 / 元信息 / 简介），底部固定「阅读最新一期」，
// 正文区挂往期列表，按服务端排序键倒序。

import android.graphics.drawable.GradientDrawable;
import android.text.TextUtils;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.widget.FrameLayout;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

import org.json.JSONArray;
import org.json.JSONObject;

public void first() {
	i.fn("ui");
	i.fn("theme");
	i.fn("icon");
	i.fn("widgets");
	i.fn("net");
	ui_init(ui_root());
	build();
}

public void second() {
	i.fn("ui");
	ui_insets();
}

public void again() {
	i.fn("ui");
	ui_insets();
}

public void back() {
	activity.finish();
}

public void md_wire() {
	i.fn("ui");
	i.fn("theme");
	i.fn("icon");
	i.fn("widgets");
	i.fn("net");
}

public JSONObject detailMag() {
	try {
		Object o = i.sss("detail.mag");
		if (o == null) {
			return null;
		}
		return new JSONObject(String.valueOf(o));
	} catch (Throwable t) {
		return null;
	}
}

public void build() {
	View bg = ui_layer("bg");
	if (bg != null) {
		bg.setBackgroundColor(ui_color(th_bg()));
	}
	View safe = ui_layer("safe");
	if (safe == null) {
		return;
	}

	LinearLayout page = ui_col();
	ui_add((ViewGroup) safe, page, -1, -1);

	page.addView(wg_header("", "", new Runnable() {
		public void run() {
			back();
		}
	}, null));
	page.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));

	ScrollView sv = new ScrollView(activity);
	sv.setVerticalScrollBarEnabled(false);
	ui_addWeight(page, sv, -1, 0, 1f);

	// 容器不留左右内边距：期次行要通到屏幕边缘，涟漪才铺满；缩进交给各行自己
	LinearLayout body = ui_col();
	body.setPadding(0, ui_dp(20), 0, ui_dp(24));
	sv.addView(body, new FrameLayout.LayoutParams(-1, -2));

	JSONObject m = detailMag();
	if (m == null) {
		body.addView(wg_message("内容已失效", "返回列表重新选择", "返回", new Runnable() {
			public void run() {
				back();
			}
		}), new LinearLayout.LayoutParams(-1, ui_dp(280)));
		return;
	}

	String name = m.optString("name", "");
	String summary = m.optString("summary", "");
	String issn = m.optString("ISSN", "");
	String cn = m.optString("CN", "");

	body.addView(coverOf(m, name, 132, 198));

	TextView t = ui_text(name, 20, th_ink1());
	t.setGravity(Gravity.CENTER_HORIZONTAL);
	t.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	LinearLayout.LayoutParams tlp = new LinearLayout.LayoutParams(-1, -2);
	tlp.topMargin = ui_dp(20);
	t.setLayoutParams(tlp);
	body.addView(t);

	String meta = "";
	if (issn.length() > 0) {
		meta = "ISSN " + issn;
	}
	if (cn.length() > 0) {
		meta = meta.length() > 0 ? meta + " · CN " + cn : "CN " + cn;
	}
	if (meta.length() > 0) {
		TextView mv = ui_text(meta, 13, th_ink2());
		mv.setGravity(Gravity.CENTER_HORIZONTAL);
		LinearLayout.LayoutParams mlp = new LinearLayout.LayoutParams(-1, -2);
		mlp.topMargin = ui_dp(8);
		mv.setLayoutParams(mlp);
		body.addView(mv);
	}

	View hr1 = wg_hairline();
	LinearLayout.LayoutParams h1 = new LinearLayout.LayoutParams(-1, 1);
	h1.topMargin = ui_dp(24);
	h1.bottomMargin = ui_dp(16);
	body.addView(hr1, h1);

	if (summary.length() > 0) {
		TextView s = ui_text(summary, 15, th_ink2());
		s.setPadding(ui_dp(20), 0, ui_dp(20), 0);
		s.setLineSpacing(0f, 1.6f);
		wg_justify(s);
		body.addView(s, new LinearLayout.LayoutParams(-1, -2));
	}

	View hr2 = wg_hairline();
	LinearLayout.LayoutParams h2 = new LinearLayout.LayoutParams(-1, 1);
	h2.topMargin = ui_dp(24);
	body.addView(hr2, h2);

	TextView label = ui_text("往期", 17, th_ink1());
	label.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	LinearLayout.LayoutParams llp = new LinearLayout.LayoutParams(-1, -2);
	llp.topMargin = ui_dp(16);
	llp.bottomMargin = ui_dp(4);
	label.setLayoutParams(llp);
	body.addView(label);

	LinearLayout list = ui_col();
	body.addView(list, new LinearLayout.LayoutParams(-1, -2));
	ui_reg("md.list", list);

	// 底部固定：主按钮
	LinearLayout foot = ui_col();
	foot.setPadding(ui_dp(20), ui_dp(8), ui_dp(20), ui_dp(12));
	foot.setBackgroundColor(ui_color(th_bg()));

	TextView btn = ui_text("阅读最新一期", 17, th_bg());
	btn.setGravity(Gravity.CENTER);
	wg_rippleFill(btn, 28, th_ink1(), false);
	btn.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			openLatest();
		}
	});
	foot.addView(btn, new LinearLayout.LayoutParams(-1, ui_dp(56)));

	page.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));
	page.addView(foot, new LinearLayout.LayoutParams(-1, -2));

	ui_reg("md.name", name);
	md_loadItems(m.optInt("id", 0));
	ui_log("magdetail build ok");
}

public FrameLayout coverOf(JSONObject m, String name, int wDp, int hDp) {
	FrameLayout box = ui_frame();
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ui_dp(wDp), ui_dp(hDp));
	lp.gravity = Gravity.CENTER_HORIZONTAL;
	box.setLayoutParams(lp);

	// 骨架屏占位，不放首字
	wg_coverBg(box, 2);

	ImageView iv = ui_image();
	iv.setScaleType(ImageView.ScaleType.CENTER_CROP);
	ui_fplace(box, iv, -1, -1, Gravity.TOP | Gravity.LEFT);

	String cover = m.optString("coverPath", "");
	if (cover.length() > 0) {
		try {
			i.us(iv, "src", cover);
		} catch (Throwable t) {
			ui_log("mag cover " + t);
		}
	}
	return box;
}

public void md_loadItems(int magazineid) {
	if (magazineid <= 0) {
		md_items(null);
		return;
	}
	new Thread(new Runnable() {
		public void run() {
			try {
				i.fn("net");
				JSONObject d = net_magItems(magazineid);
				JSONObject msg = net_msg(d);
				JSONArray arr = msg == null ? null : msg.optJSONArray("itemList");
				JSONArray got = arr;
				activity.runOnUiThread(new Runnable() {
					public void run() {
						md_items(got);
					}
				});
			} catch (Throwable t) {
				i.syso("MAGDETAIL ! " + t);
				activity.runOnUiThread(new Runnable() {
					public void run() {
						md_items(null);
					}
				});
			}
		}
	}).start();
}

public void md_items(JSONArray arr) {
	md_wire();
	LinearLayout list = (LinearLayout) ui_get("md.list");
	if (list == null) {
		return;
	}
	list.removeAllViews();

	if (arr == null) {
		list.addView(wg_message("往期加载失败", "", "重试", new Runnable() {
			public void run() {
				JSONObject m = detailMag();
				if (m != null) {
					md_loadItems(m.optInt("id", 0));
				}
			}
		}), new LinearLayout.LayoutParams(-1, ui_dp(160)));
		return;
	}
	if (arr.length() == 0) {
		list.addView(ui_text("暂无往期", 13, th_ink2()), new LinearLayout.LayoutParams(-1, -2));
		return;
	}

	ui_reg("md.items", arr.toString());
	for (int k = 0; k < arr.length(); k++) {
		JSONObject it = arr.optJSONObject(k);
		if (it == null) {
			continue;
		}
		list.addView(md_row(it, k == 0));
	}
}

public View md_row(JSONObject it, boolean newest) {
	LinearLayout row = ui_row();
	row.setGravity(Gravity.CENTER_VERTICAL);
	row.setMinimumHeight(ui_dp(56));
	// 行铺满整屏宽度，20dp 缩进做在行内：涟漪才能通到屏幕两边
	row.setPadding(ui_dp(20), 0, ui_dp(20), 0);

	String issue = it.optString("issue", "");
	if (issue.length() == 0) {
		issue = it.optString("name", "");
	}

	if (newest) {
		View dot = new View(activity);
		GradientDrawable d = new GradientDrawable();
		d.setColor(ui_color(th_accent()));
		d.setCornerRadius(ui_dp(3));
		dot.setBackground(d);
		LinearLayout.LayoutParams dlp = new LinearLayout.LayoutParams(ui_dp(6), ui_dp(6));
		dlp.rightMargin = ui_dp(8);
		row.addView(dot, dlp);
	}

	TextView t = ui_text(issue, 15, th_ink1());
	t.setSingleLine(true);
	t.setEllipsize(TextUtils.TruncateAt.END);
	row.addView(t, new LinearLayout.LayoutParams(0, -2, 1f));

	ImageView chev = ic_make("chev", 18, th_ink2());
	row.addView(chev, new LinearLayout.LayoutParams(ui_dp(24), ui_dp(24)));

	JSONObject picked = it;
	row.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			openIssue(picked);
		}
	});
	wg_ripple(row, 0, false);

	LinearLayout wrap = ui_col();
	wrap.addView(row, new LinearLayout.LayoutParams(-1, ui_dp(56)));
	wrap.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));
	return wrap;
}

public void openIssue(JSONObject it) {
	try {
		String surl = it.optString("surl", "");
		if (surl.length() == 0) {
			ui_log("期次缺少 surl");
			return;
		}
		String issue = it.optString("issue", "");
		Object n = ui_get("md.name");
		String name = n == null ? "" : String.valueOf(n);
		i.sss("reader.surl", surl);
		i.sss("reader.title", name);
		i.sss("reader.author", issue);
		i.uigo("reader.iyu");
	} catch (Throwable t) {
		ui_log("openIssue " + t);
	}
}

public void openLatest() {
	try {
		Object o = ui_get("md.items");
		if (o == null) {
			return;
		}
		JSONArray arr = new JSONArray(String.valueOf(o));
		if (arr.length() == 0) {
			return;
		}
		JSONObject it = arr.optJSONObject(0);
		if (it != null) {
			openIssue(it);
		}
	} catch (Throwable t) {
		ui_log("openLatest " + t);
	}
}
