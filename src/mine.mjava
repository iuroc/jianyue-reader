public View mine_page() {
	mine_wire();
	LinearLayout page = ui_col();
	page.addView(wg_header("我的", "", null, null));
	page.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));

	ScrollView sv = new ScrollView(activity);
	sv.setVerticalScrollBarEnabled(false);
	ui_addWeight(page, sv, -1, 0, 1f);

	// 容器不留左右内边距：可点行要通到屏幕边缘，涟漪才铺满；缩进交给各行自己
	LinearLayout body = ui_col();
	body.setPadding(0, ui_dp(16), 0, ui_dp(24));
	sv.addView(body, new FrameLayout.LayoutParams(-1, -2));

	// 主题
	TextView themeLabel = ui_text("主题", 13, th_ink2());
	themeLabel.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	body.addView(themeLabel);

	body.addView(mine_themeToggle());

	body.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));

	// 阅读历史
	TextView histLabel = ui_text("阅读历史", 17, th_ink1());
	histLabel.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(-1, -2);
	hlp.topMargin = ui_dp(20);
	hlp.bottomMargin = ui_dp(4);
	histLabel.setLayoutParams(hlp);
	body.addView(histLabel);

	LinearLayout hist = ui_col();
	body.addView(hist, new LinearLayout.LayoutParams(-1, -2));
	mine_history(hist);

	// 搜索索引
	mine_indexSection(body);

	// 关于
	mine_aboutSection(body);

	TextView ver = ui_text("简阅 " + ui_versionText() + " · 歌德借阅机内容", 13, th_ink2());
	ver.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	LinearLayout.LayoutParams vlp = new LinearLayout.LayoutParams(-1, -2);
	vlp.topMargin = ui_dp(28);
	ver.setLayoutParams(vlp);
	body.addView(ver);

	ui_log("mine build ok");
	return page;
}

// 主题切换：Chip 只当外观用，选中逻辑自己管 —— 不依赖 ChipGroup 的勾选回调
// （ChipGroup.setOnCheckedStateChangeListener 在这套解释器里没有回调过来）
public ChipGroup mine_themeToggle() {
	ChipGroup g = new ChipGroup(activity);
	LinearLayout.LayoutParams glp = new LinearLayout.LayoutParams(-1, -2);
	glp.topMargin = ui_dp(8);
	glp.bottomMargin = ui_dp(20);
	glp.leftMargin = ui_dp(20);
	glp.rightMargin = ui_dp(20);
	g.setLayoutParams(glp);

	String[] names = {"纸", "夜"};
	int cur = th_mode();
	for (int k = 0; k < 2; k++) {
		int mode = k;
		Chip c = new Chip(activity);
		c.setText(names[k]);
		c.setTextSize(15);
		// 关掉 Chip 自带的勾选：选中态由 mine_chipPaint 画，避免组件状态和真实主题不同步
		c.setCheckable(false);
		c.setCloseIconVisible(false);
		c.setChipIconVisible(false);
		c.setCheckedIconVisible(false);
		mine_chipPaint(c, mode, mode == cur);
		c.setOnClickListener(new View.OnClickListener() {
			public void onClick(View v) {
				mine_themePick(mode);
			}
		});
		ChipGroup.LayoutParams clp = new ChipGroup.LayoutParams(-2, -2);
		clp.rightMargin = ui_dp(8);
		g.addView(c, clp);
	}
	return g;
}

// 点击回调是新解释器：先 i.fn 再碰主题 / 存储函数
public void mine_themePick(int mode) {
	i.fn("theme");
	if (th_mode() == mode) {
		return;
	}
	th_set(mode);
	// 切到夜色时，阅读底色若不是夜色就一并改成夜色：夜里进阅读器必须稳定是黑的。
	// 反向不动：白天模式下阅读器用哪档底色都允许；夜间里用户自己改成白天底色，
	// 那是阅读器的局部选择，不属于「切换外部主题」
	if (th_night()) {
		i.fn("store");
		if (st_readerBg() != 3) {
			st_setInt("rd.bg", 3);
		}
	}
	i.fn("ui");
	ui_statusIcons(th_mode() != 1);
	// 整壳重建：新壳里的 chip 会按新主题重新上色
	i.fn("home");
	home_repaint();
}

// 每个 chip 画成它代表的那套主题（纸就是纸色、夜就是夜色），选中用 2dp 朱砂描边区分。
// 不要用「当前主题的墨色实心」——那样纸色主题下「纸」会被涂成深墨色，看上去像「夜」。
public void mine_chipPaint(Chip c, int mode, boolean on) {
	c.setChipBackgroundColor(ColorStateList.valueOf(ui_color(th_bgOf(mode))));
	c.setTextColor(ui_color(th_inkOf(mode)));
	c.setChipStrokeWidth(ui_dp(on ? 2 : 1));
	c.setChipStrokeColor(ColorStateList.valueOf(ui_color(on ? th_accent() : th_hairline())));
	c.setChipCornerRadius(ui_dp(18));
	c.setChipMinHeight(ui_dp(36));
	c.setEnsureMinTouchTargetSize(false);
	c.setRippleColor(ColorStateList.valueOf(ui_color(th_ripple())));
}

public void home_repaint() {
	i.fn("home");
	repaint();
}

// 搜索索引：用户自己决定何时重建（书刊目录月级更新，用户该有手动刷新入口）
public void mine_indexSection(LinearLayout body) {
	TextView head = ui_text("搜索索引", 17, th_ink1());
	head.setPadding(ui_dp(20), 0, ui_dp(20), 0);
	LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(-1, -2);
	hlp.topMargin = ui_dp(28);
	head.setLayoutParams(hlp);
	body.addView(head);

	LinearLayout row = ui_row();
	row.setGravity(Gravity.CENTER_VERTICAL);
	row.setPadding(ui_dp(20), ui_dp(14), ui_dp(20), ui_dp(14));
	row.setLayoutParams(new LinearLayout.LayoutParams(-1, -2));

	LinearLayout col = ui_col();
	TextView t = ui_text("重建索引", 15, th_ink1());
	col.addView(t);
	TextView s = ui_text("清空本地索引，重新抓取全部书刊目录", 13, th_ink2());
	LinearLayout.LayoutParams slp = new LinearLayout.LayoutParams(-1, -2);
	slp.topMargin = ui_dp(4);
	s.setLayoutParams(slp);
	col.addView(s);
	row.addView(col, new LinearLayout.LayoutParams(0, -2, 1f));

	ImageView chev = ic_make("chev", 18, th_ink2());
	row.addView(chev, new LinearLayout.LayoutParams(ui_dp(18), ui_dp(18)));

	row.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			// 交给全局进度页；旧库在新库建好前一直可用
			i.sss("boot.rebuild", "1");
			i.uigo("boot.iyu");
		}
	});
	wg_ripple(row, 0, false);
	body.addView(row);
	body.addView(wg_hairline(), new LinearLayout.LayoutParams(-1, 1));
}

