// ---------- 打开 ----------

// 打开失败：按来源分三类，原始错误直接上屏，细节收进原生弹窗。
//   net    网络取不到（非 2xx / 连接异常）        → 重试
//   gone   令牌页被重定向到 error400（书不存在）    → 重建书刊库
//   server 服务端 result!=1 且带了 errorMsg        → 重试
public void rd_fail(String kind, String detail) {
	boolean noLib = "gone".equals(kind);
	String title = noLib ? "这本书暂时打不开" : ("server".equals(kind) ? "服务端返回异常" : "网络连接失败");
	String desc = noLib ? "接口提示这本书不存在或已下线，重建书刊库后再从搜索进入"
			: ("server".equals(kind) ? "服务端没有返回可用内容，稍后重试" : "没有取到这本书的目录，检查网络后重试");
	String action = noLib ? "重建书刊库" : "重试";
	boolean rebuild = noLib;
	Runnable run = new Runnable() {
		public void run() {
			if (rebuild) {
				// 回上一页；回到首页时的 resume 会把用户带进进度页重建
				i.sss("boot.rebuild", "1");
				activity.finish();
			} else {
				rd_open();
			}
		}
	};
	rd_errorView(title, desc, action, run, detail);
}

// 翻页时某一段没取回来：只影响这一页，给重试而不是动整个书刊库
public void rd_chunkFail(int page, String detail) {
	int p = page;
	Runnable run = new Runnable() {
		public void run() {
			rd_jump(p);
		}
	};
	rd_errorView("这一页加载失败", "第 " + page + " 页没能取回，可以重试或翻到别的页", "重试", run, detail);
}

// 失败视图的唯一实现：标题 / 原始错误第一行 / 说明 / 主操作 / 查看详情
public void rd_errorView(String title, String desc, String action, Runnable run, String detail) {
	rd_wire();
	FrameLayout holder = (FrameLayout) ui_get("rd.holder");
	if (holder == null) {
		return;
	}
	holder.removeAllViews();

	LinearLayout box = ui_col();
	box.setGravity(Gravity.CENTER);

	TextView t = ui_text(title, 17, th_ink1());
	t.setGravity(Gravity.CENTER);
	box.addView(t, new LinearLayout.LayoutParams(-1, -2));

	// 原始错误类型：只取第一行上屏，细节走下面的链接
	String raw = rd_firstLine(detail);
	if (raw.length() > 0) {
		TextView r = ui_text(raw, 13, th_ink2());
		r.setGravity(Gravity.CENTER);
		LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(-1, -2);
		rlp.topMargin = ui_dp(10);
		rlp.leftMargin = ui_dp(24);
		rlp.rightMargin = ui_dp(24);
		r.setLayoutParams(rlp);
		box.addView(r);
	}

	TextView s = ui_text(desc, 13, th_ink2());
	s.setGravity(Gravity.CENTER);
	LinearLayout.LayoutParams slp = new LinearLayout.LayoutParams(-1, -2);
	slp.topMargin = ui_dp(8);
	slp.leftMargin = ui_dp(32);
	slp.rightMargin = ui_dp(32);
	s.setLayoutParams(slp);
	box.addView(s);

	TextView a = ui_text(action, 15, th_accent());
	a.setGravity(Gravity.CENTER);
	a.setPadding(ui_dp(16), ui_dp(12), ui_dp(16), ui_dp(12));
	LinearLayout.LayoutParams alp = new LinearLayout.LayoutParams(-2, -2);
	alp.topMargin = ui_dp(16);
	a.setLayoutParams(alp);
	wg_ripple(a, 20, false);
	Runnable ar = run;
	a.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			ar.run();
		}
	});
	box.addView(a);

	box.addView(rd_link("查看错误详情", detail));

	ui_fplace(holder, box, -1, -2, Gravity.CENTER);
}

// 文本按钮（下划线链接样式）：点开原生弹窗看完整错误
public TextView rd_link(String label, String detail) {
	TextView t = ui_text(label, 13, th_accent());
	t.setGravity(Gravity.CENTER);
	t.setPadding(ui_dp(16), ui_dp(10), ui_dp(16), ui_dp(10));
	// Paint.UNDERLINE_TEXT_FLAG = 8：字面量，避免 BeanShell 解析不到 framework 静态常量
	t.setPaintFlags(t.getPaintFlags() | 8);
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);
	lp.topMargin = ui_dp(4);
	t.setLayoutParams(lp);
	wg_ripple(t, 16, false);

	String d = detail;
	t.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			rd_errorDialog(d);
		}
	});
	return t;
}

// 原生弹窗：书籍地址 + 错误全文 + 时间，便于截图反馈
public void rd_errorDialog(String detail) {
	try {
		new AlertDialog.Builder(activity)
				.setTitle("错误详情")
				.setMessage(rd_errorDetail(detail))
				.setPositiveButton("关闭", null)
				.show();
	} catch (Throwable t) {
		ui_log("rd dialog " + t);
	}
}

// 只给错误类型与时间：书籍地址、请求 URL 都带接口路径，不上界面
public String rd_errorDetail(String detail) {
	String when = "";
	try {
		when = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date());
	} catch (Throwable t) {
		when = String.valueOf(System.currentTimeMillis());
	}
	String d = detail == null || detail.length() == 0 ? "（没有记录到错误类型）" : detail;
	return "错误类型：\n" + d + "\n\n时间：" + when;
}

public String rd_firstLine(String s) {
	if (s == null) {
		return "";
	}
	String t = s;
	int at = t.indexOf("\n");
	if (at >= 0) {
		t = t.substring(0, at);
	}
	if (t.length() > 60) {
		t = t.substring(0, 60) + "…";
	}
	return t;
}

// 服务端结果为空且带了 errorMsg 时按「服务端异常」；令牌页缺字段才是「书不存在」
public String rd_failKind(String e) {
	String s = e == null ? "" : e;
	if (s.indexOf("书不存在") >= 0) {
		return "gone";
	}
	if (s.indexOf("服务端拒绝") >= 0) {
		return "server";
	}
	return "net";
}

public String rd_surl() {
	try {
		Object o = i.sss("reader.surl");
		if (o != null) {
			return String.valueOf(o);
		}
	} catch (Throwable t) {
	}
	return "";
}

public void rd_open() {
	String surl = rd_surl();
	ui_log("rd open surl=[" + surl + "]");
	if (surl.length() == 0) {
		rd_status("没有可阅读的内容");
		return;
	}
	rd_status("正在打开…");
	i.fn("net");
	net_errClear();
	new Thread(new Runnable() {
		public void run() {
			try {
				i.fn("net");
				i.fn("store");
				JSONObject cat = net_catalog(surl);
				if (cat == null) {
					// 失败原因取 net 模块记下的原始信息，再按来源分「网络 / 服务端 / 书失效」
					String e = net_lastError();
					String kind = rd_failKind(e);
					i.syso("READER cat ! kind=" + kind + " err=" + e);
					activity.runOnUiThread(new Runnable() {
						public void run() {
							rd_fail(kind, e);
						}
					});
					return;
				}
				int all = cat.optInt("pageAll", 0);
				JSONArray cats = cat.optJSONArray("catalogs");
				int start = st_progressPage(surl, all);
				if (start < 1) {
					start = 1;
				}
				ui_reg("rd.pageAll", String.valueOf(all));
				ui_reg("rd.cats", cats == null ? "[]" : cats.toString());
				i.syso("READER cat all=" + all + " cats=" + (cats == null ? -1 : cats.length()) + " start=" + start);
				activity.runOnUiThread(new Runnable() {
					public void run() {
						rd_jump(start);
					}
				});
			} catch (Throwable t) {
				i.syso("READER ! " + t);
			}
		}
	}).start();
}

