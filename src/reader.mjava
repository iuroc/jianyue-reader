// ---------- 外观面板：交给 Material 的 BottomSheetDialog ----------
// 拖动关闭（内容区任意位置）、遮罩、收起动画、返回键、窗口层级都由 BottomSheetBehavior 负责，
// 不再自己写触摸跟踪。

public BottomSheetDialog rd_sheet() {
	try {
		return (BottomSheetDialog) ui_get("rd.sheet");
	} catch (Throwable t) {
		return null;
	}
}

public boolean rd_panelOpen() {
	BottomSheetDialog d = rd_sheet();
	return d != null && d.isShowing();
}

public void rd_panel(boolean show) {
	rd_wire();
	if (show) {
		rd_sheetShow();
		return;
	}
	BottomSheetDialog d = rd_sheet();
	if (d != null) {
		d.dismiss();
	}
}

public void rd_sheetShow() {
	BottomSheetDialog cur = rd_sheet();
	if (cur != null && cur.isShowing()) {
		return;
	}
	// 每次新开：ui_reg 的句柄跨页面存活，复用上一页的 dialog 会绑在旧 Activity 上
	BottomSheetDialog d = new BottomSheetDialog(activity);
	ui_reg("rd.sheet", d);
	d.setContentView(rd_sheetContent());
	rd_sheetTint(d);
	d.show();
}

// dialog 自带白底，换成纸色；容器 id 用 getIdentifier 取，避免在 BeanShell 里引用 R 类
public void rd_sheetTint(BottomSheetDialog d) {
	try {
		int id = activity.getResources().getIdentifier("design_bottom_sheet", "id", "com.google.android.material");
		if (id <= 0) {
			ui_log("sheet tint: id not found");
			return;
		}
		View v = d.findViewById(id);
		if (v != null) {
			v.setBackground(rd_sheetBg());
		}
	} catch (Throwable t) {
		ui_log("sheet tint " + t);
	}
}

public LinearLayout rd_sheetContent() {
	LinearLayout panel = ui_col();
	panel.setOrientation(LinearLayout.VERTICAL);
	panel.setPadding(ui_dp(20), ui_dp(8), ui_dp(20), ui_dp(20));

	// 抓手只是视觉暗示；拖动由 BottomSheetBehavior 实现
	LinearLayout grab = new LinearLayout(activity);
	grab.setOrientation(LinearLayout.HORIZONTAL);
	grab.setGravity(Gravity.CENTER);
	grab.setLayoutParams(new LinearLayout.LayoutParams(-1, ui_dp(16)));
	View bar = new View(activity);
	GradientDrawable gd = new GradientDrawable();
	gd.setColor(ui_color(th_placeholder()));
	gd.setCornerRadius(ui_dp(2));
	bar.setBackground(gd);
	grab.addView(bar, new LinearLayout.LayoutParams(ui_dp(36), ui_dp(4)));
	panel.addView(grab);

	panel.addView(rd_panelRow("背景", 4, st_readerBg(), 0));
	panel.addView(rd_panelRow("字号", 3, st_readerFont(), 1));
	panel.addView(rd_panelRow("字距", 3, st_readerLetter(), 2));
	panel.addView(rd_panelRow("行距", 3, st_readerLine(), 3));
	return panel;
}

public GradientDrawable rd_sheetBg() {
	GradientDrawable d = new GradientDrawable();
	d.setColor(ui_color(th_surface()));
	float r = (float) ui_dp(20);
	float z = 0f;
	d.setCornerRadii(new float[] {r, r, r, r, z, z, z, z});
	return d;
}

// 每行选项的视图句柄，改选项时只换被点中与被取消的两个背景，不重建整块
public ArrayList rd_chips(int kind) {
	Object o = i.sss("rd.chips." + kind);
	if (o == null) {
		o = new ArrayList();
		i.sss("rd.chips." + kind, o);
	}
	return (ArrayList) o;
}

public void rd_chipStyle(int kind, int idx, boolean on) {
	try {
		ArrayList l = rd_chips(kind);
		if (idx < 0 || idx >= l.size()) {
			return;
		}
		TextView c = (TextView) l.get(idx);
		c.setTextColor(ui_color(on ? th_bg() : th_ink1()));
		if (on) {
			wg_rippleFill(c, 20, th_ink1(), false);
		} else {
			wg_ripple(c, 20, false);
		}
	} catch (Throwable t) {
	}
}

public LinearLayout rd_panelRow(String label, int count, int cur, int kind) {
	LinearLayout row = ui_row();
	row.setGravity(Gravity.CENTER_VERTICAL);

	TextView t = ui_text(label, 13, th_ink2());
	row.addView(t, new LinearLayout.LayoutParams(ui_dp(48), -2));

	rd_chips(kind).clear();
	for (int k = 0; k < count; k++) {
		row.addView(rd_chip(k, cur == k, kind));
	}
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-1, -2);
	lp.topMargin = ui_dp(12);
	row.setLayoutParams(lp);
	return row;
}

public TextView rd_chip(int idx, boolean on, int kind) {
	String label = "";
	if (kind == 0) {
		label = idx == 0 ? "纸" : idx == 1 ? "米" : idx == 2 ? "绿" : "夜";
	} else {
		label = idx == 0 ? "小" : idx == 1 ? "中" : "大";
	}
	TextView c = ui_text(label, 13, on ? th_bg() : th_ink1());
	c.setGravity(Gravity.CENTER);
	LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, ui_dp(40), 1f);
	lp.leftMargin = ui_dp(4);
	lp.rightMargin = ui_dp(4);
	c.setLayoutParams(lp);
	if (on) {
		wg_rippleFill(c, 20, th_ink1(), false);
	} else {
		wg_ripple(c, 20, false);
	}

	rd_chips(kind).add(c);

	int picked = idx;
	int k2 = kind;
	c.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			rd_pick(k2, picked);
		}
	});
	return c;
}

public void rd_pick(int kind, int idx) {
	rd_wire();
	int old = 0;
	if (kind == 0) {
		old = st_readerBg();
		st_setInt("rd.bg", idx);
		View bg = ui_layer("bg");
		if (bg != null) {
			bg.setBackgroundColor(ui_color(th_reader_bg(idx)));
		}
		ui_statusIcons(idx != 3);
		rd_barApply();
	} else if (kind == 1) {
		old = st_readerFont();
		st_setInt("rd.font", idx);
	} else if (kind == 2) {
		old = st_readerLetter();
		st_setInt("rd.letter", idx);
	} else {
		old = st_readerLine();
		st_setInt("rd.line", idx);
	}

	rd_chipStyle(kind, old, false);
	rd_chipStyle(kind, idx, true);
	rd_jump(rd_page());
}
