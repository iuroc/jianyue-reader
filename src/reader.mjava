public void rd_render(int p, JSONObject chunk) {
	i.fn("store");
	String html = null;
	try {
		i.fn("net");
		html = net_pageHtml(chunk, p);
	} catch (Throwable t) {
	}
	if (html == null || html.length() == 0) {
		ui_log("rd render p=" + p + " html=null");
		rd_status("这一页没有内容");
		return;
	}
	ui_log("rd render p=" + p + " len=" + html.length());

	FrameLayout holder = (FrameLayout) ui_get("rd.holder");
	if (holder == null) {
		return;
	}
	holder.removeAllViews();

	WebView wv = new WebView(activity);
	// 缩放与视口是 WebSettings 的能力，不是 WebView 的
	WebSettings ws = wv.getSettings();
	ws.setSupportZoom(false);
	ws.setBuiltInZoomControls(false);
	ws.setDisplayZoomControls(false);
	ws.setUseWideViewPort(false);
	ws.setLoadWithOverviewMode(false);
	wv.setHorizontalScrollBarEnabled(false);
	wv.setVerticalScrollBarEnabled(false);
	// 长按保持系统默认行为（可选文字、可复制），不做拦截
	wv.setOverScrollMode(View.OVER_SCROLL_NEVER);
	wv.setBackgroundColor(ui_color(th_reader_bg(st_readerBg())));
	// 轻点正文切换底栏：监听器恒返回 false —— 滚动、选字、长按复制仍是系统默认行为，
	// 这里只旁听「按下→抬起」的落点与耗时，不消费任何事件
	// 滚动与底栏的约定：平时一滚就收起；进了「触底区」底栏恒显示，
	// 回到上面再滚才继续收起。y==oldY 的回调是布局引起的，不是用户滚动，直接忽略
	wv.setOnScrollChangeListener(new View.OnScrollChangeListener() {
		public void onScrollChange(View v, int x, int y, int oldX, int oldY) {
			if (y == oldY) {
				return;
			}
			if (rd_nearEnd()) {
				if (!rd_barOn()) {
					rd_barShow(true);
				}
				return;
			}
			if (rd_barOn()) {
				rd_barShow(false);
			}
		}
	});
	wv.setOnTouchListener(new View.OnTouchListener() {
		public boolean onTouch(View v, MotionEvent e) {
			try {
				int a = e.getActionMasked();
				// 0=ACTION_DOWN 1=ACTION_UP：用字面量，避免 BeanShell 解析 framework 静态常量
				if (a == 0) {
					i.sss("rd.tx", Float.valueOf(e.getX()));
					i.sss("rd.ty", Float.valueOf(e.getY()));
					i.sss("rd.tt", Long.valueOf(System.currentTimeMillis()));
				} else if (a == 1) {
					Object ox = i.sss("rd.tx");
					Object oy = i.sss("rd.ty");
					Object ot = i.sss("rd.tt");
					if (ox == null || oy == null || ot == null) {
						return false;
					}
					float dx = Math.abs(e.getX() - ((Number) ox).floatValue());
					float dy = Math.abs(e.getY() - ((Number) oy).floatValue());
					long ms = System.currentTimeMillis() - ((Number) ot).longValue();
					if (dx < ui_dp(8) && dy < ui_dp(8) && ms < 300) {
						rd_barToggle();
					}
				}
			} catch (Throwable t) {
				ui_log("rd tap " + t);
			}
			return false;
		}
	});
	ui_fplace(holder, wv, -1, -1, Gravity.TOP | Gravity.LEFT);
	ui_reg("rd.wv", wv);

	int bgIdx = st_readerBg();
	// 阅读底色 3 = 夜色，状态栏图标要转白
	ui_statusIcons(bgIdx != 3);
	wv.loadDataWithBaseURL("https://gede.5read.com/", rd_html(html, bgIdx), "text/html", "UTF-8", null);

	rd_saveProgress();
	rd_updateBar();
}

public String rd_html(String body, int bgIdx) {
	i.fn("store");
	int fs = 17;
	int f = st_readerFont();
	if (f == 0) {
		fs = 15;
	}
	if (f == 2) {
		fs = 20;
	}
	String ls = "0";
	if (st_readerLetter() == 1) {
		ls = "0.02em";
	}
	if (st_readerLetter() == 2) {
		ls = "0.05em";
	}
	String lh = "1.7";
	if (st_readerLine() == 0) {
		lh = "1.6";
	}
	if (st_readerLine() == 2) {
		lh = "1.9";
	}
	String bg = th_reader_bg(bgIdx);
	String ink = th_reader_ink(bgIdx);

	StringBuilder sb = new StringBuilder();
	sb.append("<html><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">");
	sb.append("<style>");
	sb.append("html,body{margin:0;padding:0;background:").append(bg).append(";color:").append(ink).append(";}");
	sb.append("body{font-size:").append(fs).append("px;line-height:").append(lh);
	sb.append(";letter-spacing:").append(ls);
	// 底边距要盖住底栏（48dp）还留口气：底栏浮在正文上，最后一行不能被它压住
	sb.append(";padding:10px 18px 76px 18px;overflow-x:hidden;");
	// 保留文字可选：长按能选中、系统菜单能复制（默认行为，不覆盖）
	sb.append("-webkit-user-select:text;user-select:text;}");
	sb.append("p{margin:0 0 .6em 0;text-align:justify;text-justify:inter-ideograph;}");
	sb.append("img{max-width:100%!important;height:auto!important;display:block;margin:8px auto;}");
	sb.append("</style></head><body>");
	sb.append(body);
	sb.append("</body></html>");
	return sb.toString();
}

// ---------- 底栏 ----------

public LinearLayout rd_bar() {
	// 底栏跟随「阅读底色」而不是 App 主题：夜间读书时底栏不该还亮着纸白
	int bgIdx = st_readerBg();
	LinearLayout bar = ui_row();
	bar.setGravity(Gravity.CENTER_VERTICAL);
	bar.setBackgroundColor(ui_color(th_reader_bg(bgIdx)));

	View tocBtn = rd_barIcon("toc", new Runnable() {
		public void run() {
			rd_openToc();
		}
	});
	ui_reg("rd.toc", tocBtn);
	bar.addView(tocBtn);

	View prevBtn = rd_barText("上一页", new Runnable() {
		public void run() {
			rd_prev();
		}
	});
	ui_reg("rd.prev", prevBtn);
	bar.addView(prevBtn, new LinearLayout.LayoutParams(-2, -1));

	TextView idx = ui_text("1 / 1", 13, th_reader_ink2(bgIdx));
	idx.setGravity(Gravity.CENTER);
	ui_reg("rd.idx", idx);
	bar.addView(idx, new LinearLayout.LayoutParams(0, -1, 1f));

	View nextBtn = rd_barText("下一页", new Runnable() {
		public void run() {
			rd_next();
		}
	});
	ui_reg("rd.next", nextBtn);
	bar.addView(nextBtn, new LinearLayout.LayoutParams(-2, -1));

	TextView aa = ui_text("Aa", 15, th_reader_ink(bgIdx));
	aa.setGravity(Gravity.CENTER);
	aa.setLayoutParams(new LinearLayout.LayoutParams(ui_dp(48), -1));
	wg_ripple(aa, 0, false);
	aa.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			rd_panel(!rd_panelOpen());
		}
	});
	ui_reg("rd.aa", aa);
	bar.addView(aa);
	return bar;
}

// 目录 / 翻页 / 外观在正文就绪前一律置灰不可点
public void rd_enable(String name, boolean on) {
	try {
		View v = (View) ui_get(name);
		if (v == null) {
			return;
		}
		v.setEnabled(on);
		v.setAlpha(on ? 1f : 0.3f);
	} catch (Throwable t) {
	}
}

public boolean rd_hasCats() {
	try {
		Object o = ui_get("rd.cats");
		if (o == null) {
			return false;
		}
		return new JSONArray(String.valueOf(o)).length() > 0;
	} catch (Throwable t) {
		return false;
	}
}

public View rd_barIcon(String icon, Runnable run) {
	View v = wg_iconButton(icon, 24, th_reader_ink(st_readerBg()), 48, run);
	return v;
}

public View rd_barText(String label, Runnable run) {
	TextView t = ui_text(label, 15, th_reader_ink(st_readerBg()));
	t.setGravity(Gravity.CENTER);
	t.setPadding(ui_dp(12), 0, ui_dp(12), 0);
	t.setLayoutParams(new LinearLayout.LayoutParams(-2, -1));
	wg_ripple(t, 0, false);
	Runnable r = run;
	t.setOnClickListener(new View.OnClickListener() {
		public void onClick(View v) {
			r.run();
		}
	});
	return t;
}

// 换底色后重建底栏：图标是现画的位图，颜色已经烤进 Bitmap，改色只能重建
public void rd_barApply() {
	try {
		LinearLayout bar = (LinearLayout) ui_get("rd.bar");
		if (bar == null) {
			return;
		}
		ViewGroup parent = (ViewGroup) bar.getParent();
		if (parent == null) {
			return;
		}
		boolean on = rd_barOn();
		parent.removeView(bar);
		LinearLayout nb = rd_bar();
		ui_reg("rd.bar", nb);
		parent.addView(nb, new FrameLayout.LayoutParams(-1, ui_dp(48), Gravity.BOTTOM));
		rd_updateBar();
		// 换底色不该顺手把底栏弹出来：沿用当前显隐
		if (on) {
			nb.setVisibility(View.VISIBLE);
			nb.setAlpha(1f);
		} else {
			nb.setVisibility(View.GONE);
		}
	} catch (Throwable t) {
		ui_log("rd_barApply " + t);
	}
}

// ---------- 底栏显隐 ----------
// 阅读时正文优先：底栏默认藏起来，点一下正文交替显示（图标现画成位图，颜色改不了，只切可见性）

public boolean rd_barOn() {
	try {
		Object o = i.sss("rd.barOn");
		return o != null && "1".equals(String.valueOf(o));
	} catch (Throwable t) {
		return false;
	}
}

public void rd_barShow(boolean on) {
	try {
		i.sss("rd.barOn", on ? "1" : "0");
		LinearLayout bar = (LinearLayout) ui_get("rd.bar");
		if (bar == null) {
			return;
		}
		if (on) {
			bar.setVisibility(View.VISIBLE);
			bar.setAlpha(0f);
			bar.animate().alpha(1f).setDuration(160).start();
		} else {
			bar.setVisibility(View.GONE);
		}
	} catch (Throwable t) {
		ui_log("rd barShow " + t);
	}
}

public void rd_barToggle() {
	rd_barShow(!rd_barOn());
}

public void rd_updateBar() {
	int all = rd_pageAll();
	int p = rd_page();
	TextView idx = (TextView) ui_get("rd.idx");
	if (idx != null) {
		// 总页数还没回来时不显示「1 / 0」，用破折号占位
		idx.setText(all > 0 ? (p + " / " + all) : "—");
	}
	// 正文没就绪（还在请求 / 目录没回来 / 页码未知）时，底栏一律不可用
	boolean ready = all > 0;
	rd_enable("rd.prev", ready && p > 1);
	rd_enable("rd.next", ready && p < all);
	rd_enable("rd.toc", ready && rd_hasCats());
	rd_enable("rd.aa", ready);
}

// 触底区宽度：距正文末尾这么近就算「读到底了」，底栏在这个区域里恒显示
public int rd_endZone() {
	return ui_dp(120);
}

// 是否已进入触底区（含正文不满一屏、压根没得滚的情况由调用方按 y==oldY 过滤）
public boolean rd_nearEnd() {
	WebView wv = rd_wv();
	if (wv == null) {
		return false;
	}
	try {
		int y = wv.getScrollY();
		int vh = wv.getHeight();
		int ch = (int) (wv.getContentHeight() * wv.getScale());
		return ch > 0 && y + vh >= ch - rd_endZone();
	} catch (Throwable t) {
		return false;
	}
}

public void rd_next() {
	int all = rd_pageAll();
	int p = rd_page();
	if (p >= all) {
		return;
	}
	rd_jump(p + 1);
}

public void rd_prev() {
	int p = rd_page();
	if (p <= 1) {
		return;
	}
	rd_jump(p - 1);
}

