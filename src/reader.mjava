public void rd_wire() {
	i.fn("ui");
	i.fn("theme");
	i.fn("icon");
	i.fn("widgets");
	i.fn("net");
	i.fn("store");
}

// 跳到指定页：缓存命中直接渲染，否则后台取该页所在段
public void rd_jump(int p) {
	rd_wire();
	int all = rd_pageAll();
	p = net_clampPage(p, all);
	ui_reg("rd.page", String.valueOf(p));
	rd_updateBar();

	String surl = rd_surl();
	JSONObject hit = null;
	try {
		i.fn("net");
		hit = net_chunkLookup(surl, p);
	} catch (Throwable t) {
	}
	ui_log("rd jump p=" + p + " all=" + all + " hit=" + (hit != null));
	if (hit != null) {
		rd_render(p, hit);
		return;
	}

	rd_status("正在载入…");
	int target = p;
	new Thread(new Runnable() {
		public void run() {
			try {
				i.fn("net");
				JSONObject chunk = net_chunkAt(surl, target);
				String e = chunk == null ? net_lastError() : "";
				activity.runOnUiThread(new Runnable() {
					public void run() {
						if (chunk == null) {
							i.syso("READER chunk ! p=" + target + " err=" + e);
							rd_chunkFail(target, e);
						} else {
							rd_render(target, chunk);
						}
					}
				});
			} catch (Throwable t) {
				i.syso("READER chunk ! " + t);
			}
		}
	}).start();
}

// ---------- 渲染 ----------

public WebView rd_wv() {
	try {
		return (WebView) ui_get("rd.wv");
	} catch (Throwable t) {
		return null;
	}
}

public void rd_status(String text) {
