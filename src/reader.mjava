// ---------- 入口 ----------

public void first() {
	i.fn("ui");
	i.fn("theme");
	i.fn("icon");
	i.fn("widgets");
	i.fn("net");
	i.fn("store");
	ui_init(ui_root());
	build();
}

public void second() {
	i.fn("ui");
	rd_insets();
}

public void again() {
	i.fn("ui");
	// 从别的页面回来时系统会把系统栏弹回来，重新藏一次
	rd_fullscreen();
	rd_insets();
}

// 阅读页满屏：只藏状态栏，底部导航条不动（底栏按钮还要用）
public void rd_fullscreen() {
	try {
		WindowInsetsController wic = activity.getWindow().getInsetsController();
		if (wic == null) {
			return;
		}
		wic.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
		wic.hide(WindowInsets.Type.statusBars());
	} catch (Throwable t) {
		ui_log("rd fullscreen " + t);
	}
}

// 状态栏藏掉后顶部不该再留那一条：ui_insets 拿不到 inset 时会走 dimens 兜底，
// 这里把顶部补白清零，底部（导航条 / 键盘 / 缺口）照旧
public void rd_insets() {
	ui_insets();
	View safe = ui_layer("safe");
	if (safe != null) {
		safe.setPadding(0, 0, 0, safe.getPaddingBottom());
	}
	View overlay = ui_layer("overlay");
	if (overlay != null) {
		overlay.setPadding(0, 0, 0, overlay.getPaddingBottom());
	}
}

public void key(Object kc) {
	rd_wire();
	i.fn("toc");
	int code = 0;
	try {
		if (kc instanceof Number) {
			code = ((Number) kc).intValue();
		}
	} catch (Throwable t) {
	}
	if (code != 4) {
		return;
	}
	if (rd_panelOpen()) {
		rd_panel(false);
		return;
	}
	i.fn("toc");
	if (toc_isOpen()) {
		toc_close();
		return;
	}
	rd_saveProgress();
	activity.finish();
}

// ---------- 骨架 ----------

public void build() {
	ui_log("rd build>");
	// 阅读页满屏：状态栏藏起来，正文从屏幕顶边开始
	rd_fullscreen();
	// 先清掉上一本书留下的页码 / 总页数 / 目录：ui_reg 的句柄跨页面存活，
	// 不清的话新书在目录回来之前会先显示上一本的「300 / 500」
	rd_reset();
	i.fn("net");
	// 缓存对象在 UI 线程建，别等后台线程第一次调用时去写 i.sss
	net_cacheInit();
	View bg = ui_layer("bg");
	if (bg != null) {
		bg.setBackgroundColor(ui_color(th_reader_bg(st_readerBg())));
	}
	View safe = ui_layer("safe");
	if (safe == null) {
		ui_log("rd build safe=null");
		return;
	}
	ui_log("rd build bg ok");

	i.fn("toc");
	LinearLayout col = ui_col();
	toc_wrap((ViewGroup) safe, col);

	// 底栏浮在正文之上（不是分栏）：显示/隐藏不会让正文重排，阅读位置不跳
	FrameLayout stage = ui_frame();
	ui_addWeight(col, stage, -1, 0, 1f);
	ui_reg("rd.stage", stage);

	FrameLayout holder = ui_frame();
	ui_fplace(stage, holder, -1, -1, Gravity.TOP | Gravity.LEFT);
	ui_reg("rd.holder", holder);
	ui_log("rd build holder ok");

	LinearLayout bar = rd_bar();
	ui_reg("rd.bar", bar);
	ui_fplace(stage, bar, -1, ui_dp(48), Gravity.BOTTOM);
	// 建栏之后先跑一次：此时 pageAll=0，底栏全部置灰，等正文渲染完再放开
	rd_updateBar();
	// 进来先亮着：短页滚不动、不会触发滚动收起，所以不必再靠内容长度去猜
	rd_barShow(true);
	ui_log("rd build bar ok");

	rd_titleShow();
	ui_log("rd build title ok");
	rd_open();
}

